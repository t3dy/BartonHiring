# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/wbrxzhlrigwdhokzwulo/settings/api
# Copy this file to .env.local and fill in the values

# Supabase API URL (e.g., https://wbrxzhlrigwdhokzwulo.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (from API Settings)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# If these variables are not set, the app will fall back to localStorage
# This allows the app to work without Supabase configured during development
